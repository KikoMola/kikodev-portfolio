---
import { facts, links } from '../data/profile';
import ArrowUpRight from './ArrowUpRight.astro';

const factDelay = (i: number) => `--reveal-delay: ${250 + i * 80}ms`;
---

<section class="pt-8 lg:pt-12">
    <h1 class="text-[27vw] font-bold leading-[0.82] tracking-[-0.06em] lg:whitespace-nowrap lg:text-[length:min(calc((100vw_-_110px)/5),300px)]">
        <span class="block overflow-hidden pb-[0.04em] lg:inline-block" data-reveal="rise"><span>Kiko</span></span>
        <span class="block overflow-hidden pb-[0.04em] lg:inline-block" data-reveal="rise" style="--reveal-delay: 90ms"><span>Guirado</span></span>
    </h1>

    <dl class="mt-10 grid grid-cols-2 gap-x-5 gap-y-8 lg:mt-14 lg:grid-cols-4">
        {facts.map((fact, i) => (
            <div class="flex flex-col gap-2.5 border-t border-ink pt-3.5" data-reveal style={factDelay(i)}>
                <dt class="font-mono text-[11px] uppercase tracking-[0.06em] text-ink-muted">{fact.label}</dt>
                <dd class="text-xl font-medium leading-tight tracking-[-0.02em] lg:text-2xl">{fact.value}</dd>
            </div>
        ))}
        <div class="flex flex-col gap-2.5 border-t border-ink pt-3.5" data-reveal style={factDelay(facts.length)}>
            <dt class="font-mono text-[11px] uppercase tracking-[0.06em] text-ink-muted">Enlaces</dt>
            <dd class="flex flex-wrap gap-x-5 gap-y-1 text-xl font-medium leading-tight tracking-[-0.02em] lg:text-2xl">
                <a href={links.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 underline decoration-1 underline-offset-[5px] hover:decoration-2">LinkedIn<ArrowUpRight class="size-[0.75em]" /></a>
                <a href={links.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 underline decoration-1 underline-offset-[5px] hover:decoration-2">GitHub<ArrowUpRight class="size-[0.75em]" /></a>
            </dd>
        </div>
    </dl>
</section>
