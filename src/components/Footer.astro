---
import { links } from '../data/profile';
import ArrowUpRight from './ArrowUpRight.astro';

const contactLinks = [
    { href: links.linkedin, label: 'LinkedIn' },
    { href: links.github, label: 'GitHub' },
];

const year = new Date().getFullYear();
---

<footer id="contacto" class="mt-28 bg-accent text-white lg:mt-40">
    <div class="mx-auto flex max-w-[1600px] flex-col gap-12 px-5 pb-7 pt-5 lg:gap-14 lg:px-10">
        <div class="grid grid-cols-1 gap-y-4 lg:grid-cols-12 lg:gap-x-5">
            <span class="font-mono text-xs uppercase tracking-[0.04em] lg:col-span-3">03 / Contacto</span>
            <p class="max-w-xs text-base leading-normal lg:col-span-3 lg:col-start-10">
                Escríbeme por LinkedIn o echa un vistazo a mi código en GitHub.
            </p>
        </div>

        <h2 class="text-[18vw] font-bold leading-[0.85] tracking-[-0.06em] lg:text-[length:min(18vw,280px)]" data-reveal>
            ¿Hablamos?
        </h2>

        <div class="grid grid-cols-1 lg:grid-cols-2 lg:gap-x-5">
            {contactLinks.map((link, i) => (
                <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-between border-t border-white py-5 text-[28px] font-semibold tracking-[-0.03em] transition-[padding] duration-300 ease-[cubic-bezier(.2,.7,.2,1)] hover:pl-4 lg:text-[44px]"
                    data-reveal
                    style={`--reveal-delay: ${i * 90}ms`}
                >
                    {link.label}
                    <ArrowUpRight class="size-7 lg:size-10" strokeWidth={1.5} />
                </a>
            ))}
        </div>

        <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-white pt-4 font-mono text-xs tracking-[0.02em]">
            <span>© {year} Kiko Guirado</span>
            <span>Hecho con Astro</span>
            <a href="#top" class="inline-flex items-center gap-1 py-2 underline decoration-1 underline-offset-[5px] hover:decoration-2">
                Volver arriba
                <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 19V5" />
                    <path d="m6 11 6-6 6 6" />
                </svg>
            </a>
        </div>
    </div>
</footer>
