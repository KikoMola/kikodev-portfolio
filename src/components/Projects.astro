---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

// En escritorio los dos destacados comparten fila y el resto va de tres en tres:
// el retraso escalona las tarjetas de cada fila.
const featuredCount = projects.filter((project) => project.featured).length;
const delayFor = (i: number) => (i < featuredCount ? i : (i - featuredCount) % 3) * 90;
---

<section id="proyectos" class="mt-24 flex scroll-mt-6 flex-col gap-10 lg:mt-36 lg:gap-12">
    <div class="grid grid-cols-1 gap-y-4 border-t-2 border-ink pt-4 lg:grid-cols-12 lg:items-end lg:gap-x-5">
        <span class="font-mono text-xs uppercase tracking-[0.04em] lg:col-span-3 lg:self-start">01 / Proyectos</span>
        <h2 class="text-5xl font-bold leading-[0.9] tracking-[-0.05em] lg:col-span-6 lg:text-[length:clamp(64px,6.1vw,88px)]" data-reveal>
            Trabajo seleccionado
        </h2>
        <p class="max-w-sm text-base leading-normal text-ink-muted lg:col-span-3" data-reveal style="--reveal-delay: 90ms">
            Aplicaciones y herramientas que he diseñado, desarrollado y desplegado de principio a fin.
        </p>
    </div>

    <div class="grid grid-cols-1 gap-y-14 md:grid-cols-2 md:gap-x-5 lg:grid-cols-12 lg:gap-y-16">
        {projects.map((project, i) => (
            <ProjectCard project={project} index={i} delay={delayFor(i)} />
        ))}
    </div>
</section>
