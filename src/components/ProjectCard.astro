---
import type { CoverTone, Project } from '../data/projects';
import ArrowUpRight from './ArrowUpRight.astro';

interface Props {
    project: Project;
    index: number;
    /** Retraso de la animación de entrada, para escalonar las tarjetas de una misma fila. */
    delay: number;
}

const { project, index, delay } = Astro.props;
const { title, description, stack, url, urlLabel, repoUrl, tone, featured } = project;

const toneClasses: Record<CoverTone, string> = {
    accent: 'bg-accent text-white',
    ink: 'bg-ink text-paper',
    paper: 'bg-paper-deep text-ink',
};

const number = String(index + 1).padStart(2, '0');
---

<article
    class:list={['group flex flex-col gap-5', featured ? 'lg:col-span-6' : 'lg:col-span-4']}
    data-reveal
    style={`--reveal-delay: ${delay}ms`}
>
    <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Visitar ${title}`}
        class:list={[
            'flex flex-col justify-between overflow-hidden p-5 transition-transform duration-[350ms] ease-[cubic-bezier(.2,.7,.2,1)] group-hover:-translate-y-1.5',
            featured ? 'h-[300px] lg:h-[420px] lg:p-6' : 'h-[240px] lg:h-[300px]',
            toneClasses[tone],
        ]}
    >
        <div class="flex justify-between gap-3 font-mono text-xs tracking-[0.02em]">
            <span>{number}</span>
            <span class="flex min-w-0 items-center gap-1">
                <span class="truncate">{urlLabel}</span>
                <ArrowUpRight class="size-3 shrink-0" />
            </span>
        </div>
        <span
            class:list={[
                'text-balance font-bold',
                featured
                    ? 'text-[length:clamp(56px,7.5vw,112px)] leading-[0.85] tracking-[-0.06em]'
                    : 'text-[44px] leading-[0.9] tracking-[-0.05em] lg:text-[length:clamp(40px,3.9vw,56px)]',
            ]}
        >
            {title}
        </span>
    </a>

    <div class:list={['flex flex-col gap-2.5', featured && 'lg:grid lg:grid-cols-6 lg:gap-x-5']}>
        <p class:list={['text-base leading-normal', featured && 'lg:col-span-4 lg:text-lg lg:leading-[1.45]']}>
            {description}
        </p>
        <div class="flex flex-col items-start gap-2.5 lg:col-span-2">
            <span class="font-mono text-xs leading-[1.7] text-ink-muted">{stack.join(' / ')}</span>
            {repoUrl && (
                <a
                    href={repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-[15px] font-medium underline decoration-1 underline-offset-[5px] hover:decoration-2"
                >
                    Código en GitHub<ArrowUpRight class="size-3.5" />
                </a>
            )}
        </div>
    </div>
</article>
